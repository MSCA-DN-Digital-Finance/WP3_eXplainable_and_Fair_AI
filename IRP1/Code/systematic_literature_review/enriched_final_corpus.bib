@article{lucarelli_deep_2020,
 abstract = {<jats:title>Abstract</jats:title><jats:p>Deep reinforcement learning is gaining popularity in many different fields. An interesting sector is related to the definition of dynamic decision-making systems. A possible example is dynamic portfolio optimization, where an agent has to continuously reallocate an amount of fund into a number of different financial assets with the final goal of maximizing return and minimizing risk. In this work, a novel deep Q-learning portfolio management framework is proposed. The framework is composed by two elements: a set of local agents that learn assets behaviours and a global agent that describes the global reward function. The framework is tested on a crypto portfolio composed by four cryptocurrencies. Based on our results, the deep reinforcement portfolio management framework has proven to be a promising approach for dynamic portfolio optimization.</jats:p>},
 author = {Giorgio Lucarelli and Matteo Borrotti},
 doi = {10.1007/s00521-020-05359-8},
 journal = {Neural Computing and Applications},
 keywords = {},
 number = {23},
 pages = {17229--17244},
 title = {A deep Q-learning portfolio management framework for the cryptocurrency market},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091144928&doi=10.1007%2fs00521-020-05359-8&partnerID=40&md5=7e5a2cc8394083d68a15b052a47c4ea8},
